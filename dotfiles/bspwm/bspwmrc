#! /bin/sh

# pgrep -x sxhkd > /dev/null || sxhkd &

bspc monitor HDMI-1 -d I II III IV V VI VII VIII IX X

bspc config border_width         2
bspc config window_gap          12

bspc config split_ratio          0.52
bspc config borderless_monocle   true
bspc config gapless_monocle      true

systemctl --user start picom.service &
systemctl --user start dunst.service &
systemclt --user start sxhkd.service &

bspc subscribe monitor_geomentry | while read -r _; do
    feh --bg-scale ~/media/wallpapers/wp_01.jpg
done &
